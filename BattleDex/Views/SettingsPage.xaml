<Page
    x:Class="BattleDex.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="0,12,0,24" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock
                x:Uid="Settings_Title"
                Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                x:Uid="Settings_PokedexHeader"
                Style="{ThemeResource BodyStrongTextBlockStyle}" />
            <ToggleSwitch
                x:Uid="Settings_ShowCaughtColumn"
                IsOn="{x:Bind ViewModel.ShowCaughtColumn, Mode=TwoWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
